# Environment variables for SolarCharge-Finder
# Copy to .env and fill values before running locally

PORT=5000
MONGO_URI=mongodb://localhost:27017/solarcharge
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30d
EMAIL_SERVICE_API_KEY=
GOOGLE_MAPS_API_KEY=
NODE_ENV=development

# Optional
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
